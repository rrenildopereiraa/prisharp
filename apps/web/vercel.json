{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "vite",
	"buildCommand": "pnpm run build",
	"outputDirectory": "dist",
	"headers": [
		{
			"source": "/(prisharp.*\\.zip)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/chrome",
			"destination": "https://chromewebstore.google.com/detail/prisharp-see-what-any-sit/ahjcmijihodolfhcdeapnbmpihkoolhn",
			"permanent": false
		},
		{
			"source": "/firefox",
			"destination": "https://addons.mozilla.org/firefox/addon/prisharp/",
			"permanent": false
		},
		{
			"source": "/get",
			"has": [
				{
					"type": "header",
					"key": "user-agent",
					"value": ".*Firefox/.*"
				}
			],
			"destination": "https://addons.mozilla.org/firefox/addon/prisharp/",
			"permanent": false
		},
		{
			"source": "/get",
			"destination": "https://chromewebstore.google.com/detail/prisharp-see-what-any-sit/ahjcmijihodolfhcdeapnbmpihkoolhn",
			"permanent": false
		}
	]
}
