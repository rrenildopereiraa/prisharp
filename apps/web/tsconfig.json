{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowJs": true,
		"isolatedModules": true,
		"types": ["vite-plus/client", "node"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "api", "vite.config.ts"]
}
