{
	"name": "extension",
	"version": "0.1.0",
	"private": true,
	"description": "See the tech behind any site, in one click.",
	"license": "MIT",
	"type": "module",
	"exports": {
		"./technologies": "./src/technologies.js",
		"./icons": "./src/icons.js",
		"./icons/*": "./icons/tech/*"
	},
	"scripts": {
		"build": "yummacss build",
		"watch": "yummacss watch",
		"validate": "yummacss lint",
		"icons": "node scripts/icons.mjs",
		"test": "vp test run",
		"zip": "yummacss build && rm -f prisharp.zip && zip -r prisharp.zip manifest.json popup.html popup.css src icons"
	},
	"devDependencies": {
		"@ridemountainpig/svgl-react": "^1.0.18",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"vite-plus": "catalog:",
		"yummacss": "^4.8.0"
	}
}
