{
	"manifest_version": 3,
	"name": "Prisharp",
	"description": "See the tech behind any site, in one click.",
	"version": "0.1.0",
	"homepage_url": "https://prisharp.com",
	"action": {
		"default_popup": "popup.html",
		"default_title": "Prisharp"
	},
	"permissions": ["activeTab", "scripting"],
	"icons": {
		"16": "icons/16.png",
		"32": "icons/32.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	}
}
